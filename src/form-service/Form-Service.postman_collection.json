{
	"info": {
		"name": "Form Service API",
		"description": "API collection for Form Service. Manages dynamic form templates for insurance applications.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://form-service-cchvangsfpfdb3ha.uaenorth-01.azurewebsites.net/api",
			"type": "string"
		},
		{
			"key": "template_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "insurance_line",
			"value": "MEDICAL",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Templates",
			"item": [
				{
					"name": "List Templates",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/templates-list?insuranceLine={{insurance_line}}&status=completed",
							"host": ["{{base_url}}"],
							"path": ["templates-list"],
							"query": [
								{
									"key": "insuranceLine",
									"value": "{{insurance_line}}"
								},
								{
									"key": "status",
									"value": "completed"
								}
							]
						},
						"description": "List all form templates with optional filters"
					}
				},
				{
					"name": "Get Template by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/templates/{{template_id}}?insuranceLine={{insurance_line}}",
							"host": ["{{base_url}}"],
							"path": ["templates", "{{template_id}}"],
							"query": [
								{
									"key": "insuranceLine",
									"value": "{{insurance_line}}"
								}
							]
						},
						"description": "Get a specific template by ID"
					}
				},
				{
					"name": "Create Template",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Medical Individual Form\",\n  \"insuranceLine\": \"MEDICAL\",\n  \"organizationId\": \"individual\",\n  \"description\": \"Form template for medical individual insurance\",\n  \"status\": \"draft\",\n  \"sections\": []\n}"
						},
						"url": {
							"raw": "{{base_url}}/templates",
							"host": ["{{base_url}}"],
							"path": ["templates"]
						},
						"description": "Create a new form template"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.templateId) {",
									"        pm.environment.set(\"template_id\", response.templateId);",
									"    }",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Update Template",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Template Name\",\n  \"description\": \"Updated description\",\n  \"status\": \"completed\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/templates-update/{{template_id}}?insuranceLine={{insurance_line}}",
							"host": ["{{base_url}}"],
							"path": ["templates-update", "{{template_id}}"],
							"query": [
								{
									"key": "insuranceLine",
									"value": "{{insurance_line}}"
								}
							]
						},
						"description": "Update an existing template"
					}
				},
				{
					"name": "Auto-save Template",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"templateId\": \"{{template_id}}\",\n  \"name\": \"Auto-saved Template\",\n  \"status\": \"draft\",\n  \"sections\": []\n}"
						},
						"url": {
							"raw": "{{base_url}}/templates-autosave",
							"host": ["{{base_url}}"],
							"path": ["templates-autosave"]
						},
						"description": "Auto-save template (creates or updates as draft)"
					}
				},
				{
					"name": "Delete Template",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/templates-delete/{{template_id}}?insuranceLine={{insurance_line}}",
							"host": ["{{base_url}}"],
							"path": ["templates-delete", "{{template_id}}"],
							"query": [
								{
									"key": "insuranceLine",
									"value": "{{insurance_line}}"
								}
							]
						},
						"description": "Delete a template"
					}
				}
			]
		}
	]
}




