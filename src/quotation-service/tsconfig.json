{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/functions/customer/rejectPlans.test.ts",
    "src/functions/customer/requestRevision.test.ts",
    "src/functions/quotations/getQuotationHistory.test.ts",
    "src/tests/handlePipelineAction.test.ts",
    "src/tests/listQuotations-filtering.test.ts",
    "src/tests/selectPlan.test.ts",
    "src/utils/urlHelper.test.ts"
  ]
}
