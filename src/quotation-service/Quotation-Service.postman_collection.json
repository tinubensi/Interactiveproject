{
	"info": {
		"name": "Quotation Service API",
		"description": "API collection for Quotation Service. Manages insurance quotations from selected plans to final quotation documents.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://quotation-service-74e1210c.azurewebsites.net/api",
			"type": "string"
		},
		{
			"key": "quotation_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "lead_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Quotations",
			"item": [
				{
					"name": "Create Quotation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"leadId\": \"{{lead_id}}\",\n  \"customerId\": \"customer-123\",\n  \"planIds\": [\"plan-1\", \"plan-2\"],\n  \"lineOfBusiness\": \"medical\",\n  \"businessType\": \"individual\",\n  \"validityDays\": 30,\n  \"termsAndConditions\": \"Standard terms apply\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/quotations",
							"host": ["{{base_url}}"],
							"path": ["quotations"]
						},
						"description": "Create a new quotation from selected plans"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.quotation) {",
									"        pm.environment.set(\"quotation_id\", response.data.quotation.id);",
									"    }",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "List Quotations",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"leadId\": \"{{lead_id}}\",\n  \"page\": 1,\n  \"limit\": 20,\n  \"sortBy\": \"createdAt\",\n  \"sortOrder\": \"desc\",\n  \"filters\": {\n    \"status\": [\"draft\", \"sent\"],\n    \"lineOfBusiness\": [\"medical\"]\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/quotations/list",
							"host": ["{{base_url}}"],
							"path": ["quotations", "list"]
						},
						"description": "List quotations with filters and pagination"
					}
				},
				{
					"name": "Get Quotation",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/quotations/{{quotation_id}}?leadId={{lead_id}}",
							"host": ["{{base_url}}"],
							"path": ["quotations", "{{quotation_id}}"],
							"query": [
								{
									"key": "leadId",
									"value": "{{lead_id}}"
								}
							]
						},
						"description": "Get quotation by ID with plans"
					}
				},
				{
					"name": "Update Quotation",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"sent\",\n  \"remarks\": {\n    \"gettingPaymentLink\": \"Payment link sent\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/quotations/{{quotation_id}}?leadId={{lead_id}}",
							"host": ["{{base_url}}"],
							"path": ["quotations", "{{quotation_id}}"],
							"query": [
								{
									"key": "leadId",
									"value": "{{lead_id}}"
								}
							]
						},
						"description": "Update quotation"
					}
				},
				{
					"name": "Change Status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quotationId\": \"{{quotation_id}}\",\n  \"status\": \"approved\",\n  \"reason\": \"Customer approved\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/quotations/{{quotation_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["quotations", "{{quotation_id}}", "status"]
						},
						"description": "Change quotation status"
					}
				},
				{
					"name": "Send Quotation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quotationId\": \"{{quotation_id}}\",\n  \"recipientEmail\": \"customer@example.com\",\n  \"recipientName\": \"John Doe\",\n  \"message\": \"Please find your quotation attached\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/quotations/{{quotation_id}}/send",
							"host": ["{{base_url}}"],
							"path": ["quotations", "{{quotation_id}}", "send"]
						},
						"description": "Send quotation to customer via email"
					}
				},
				{
					"name": "Revise Quotation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"planIds\": [\"plan-3\", \"plan-4\"],\n  \"reason\": \"Customer requested different plans\",\n  \"remarks\": \"Revised based on customer feedback\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/quotations/{{quotation_id}}/revise",
							"host": ["{{base_url}}"],
							"path": ["quotations", "{{quotation_id}}", "revise"]
						},
						"description": "Create a revision of a quotation"
					}
				},
				{
					"name": "Get Revisions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/quotations/{{quotation_id}}/revisions",
							"host": ["{{base_url}}"],
							"path": ["quotations", "{{quotation_id}}", "revisions"]
						},
						"description": "Get revision history for a quotation"
					}
				}
			]
		}
	]
}




