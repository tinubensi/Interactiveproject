{
  "name": "emaf-pdf-vm",
  "version": "1.0.0",
  "description": "EMAF PDF Generation Service for VM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "mkdir -p dist/templates && cp -r templates/* dist/templates/",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "postinstall": "npx playwright install chromium --with-deps || echo 'Playwright browser installation skipped (may already be installed)'"
  },
  "dependencies": {
    "@azure/cosmos": "^4.0.0",
    "@azure/storage-blob": "^12.17.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "handlebars": "^4.7.8",
    "playwright": "1.57.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
