{
  "name": "quotation-generation-service",
  "version": "1.0.0",
  "description": "Quotation Generation Service - Plan Fetching and Comparison",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "npx func start --port 7072",
    "prestart": "npm run build",
    "clean": "rimraf dist",
    "setup": "npm run build && node dist/scripts/setup-database.js",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "test:api": "bash scripts/test-api.sh"
  },
  "dependencies": {
    "@azure/arm-appcontainers": "^2.0.0",
    "@azure/cosmos": "^4.0.0",
    "@azure/eventgrid": "^5.0.0",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/storage-queue": "^12.17.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "azure-functions-core-tools": "^4.6.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3"
  }
}
